generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  moods     Mood[]
  createdAt DateTime @default(now())
}

model Mood {
  id        String   @id @default(cuid())
  mood      String   // happy | okay | sad | anxious | energetic
  note      String?
  date      String   // YYYY-MM-DD
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id])
  createdAt DateTime @default(now())
}
